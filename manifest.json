{
  "manifest_version": 3,
  "name": "Korean EPUB Hanja & Loanword Annotator",
  "version": "1.0.15",
  "description": "Annotate DRM-free Korean EPUBs using dictionary-based Hanja and loanword analysis, with resumable manual/API review and export a valid EPUB.",
  "permissions": [
    "activeTab",
    "scripting",
    "webNavigation",
    "storage",
    "contextMenus",
    "offscreen",
    "unlimitedStorage",
    "clipboardWrite"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "打开韩语 EPUB 标注器",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "minimum_chrome_version": "116",
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "host_permissions": [
    "https://*/*",
    "http://*/*"
  ]
}
